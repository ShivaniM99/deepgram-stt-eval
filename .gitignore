.env
.venv/
__pycache__/
*.pyc
.cache/
data/corpus/audio/
data/corpus/manifest.jsonl
data/external/
# Recordings are a person's voice. They stay local unless their owner
# deliberately chooses to publish them -- note the ** so archived takes in
# subdirectories are covered too, which an earlier single-level pattern missed.
data/recordings/**/*.wav
data/recordings/**/*.m4a
data/recordings/**/*.mp3
data/recordings/**/*.flac
data/recordings/**/*.aiff
!data/recordings/.gitkeep
reports/*.html
# The memo and the generated report are the deliverables -- a reviewer should
# be able to read the actual results without an API key and a 20-minute run.
!reports/MEMO.md
!reports/launch_readiness.md
!reports/.gitkeep
sessions/
.DS_Store
